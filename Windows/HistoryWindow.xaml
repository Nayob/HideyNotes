<Window x:Class="HideyNotes.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:HideyNotes.Models"
        Title="{DynamicResource Loc.hist.windowTitle}"
        Width="540" Height="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid Margin="18">
        <Border Background="{DynamicResource CardBrush}"
                CornerRadius="16"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderDrag">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.hist.title}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="HintText"
                                   Text="{DynamicResource Loc.hist.hintClosed}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="SearchButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE721;"
                                Margin="0,0,2,0"
                                Click="OnSearchClick" />
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE711;"
                                Click="OnCloseClick" />
                    </StackPanel>
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                    <RadioButton x:Name="ModeHistory" Style="{StaticResource Segment}" GroupName="histMode"
                                 Content="{DynamicResource Loc.hist.modeClosed}" Tag="history" Checked="OnModeChecked" />
                    <RadioButton x:Name="ModeTrash" Style="{StaticResource Segment}" GroupName="histMode"
                                 Content="{DynamicResource Loc.hist.modeTrash}" Tag="trash" Checked="OnModeChecked" />
                </WrapPanel>

                <Border x:Name="SearchBar"
                        Grid.Row="2"
                        Margin="0,10,0,0"
                        Padding="10,3"
                        Background="{DynamicResource SegmentBrush}"
                        BorderBrush="{DynamicResource SegmentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,8,0" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 TextChanged="OnSearchTextChanged"
                                 KeyDown="OnSearchBoxKeyDown" />

                        <TextBlock x:Name="SearchPlaceholder"
                                   Grid.Column="1"
                                   Text="{DynamicResource Loc.hist.searchPlaceholder}"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />

                        <TextBlock x:Name="SearchInfo"
                                   Grid.Column="2"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   MinWidth="46"
                                   TextAlignment="Right" />

                        <Button x:Name="ClearSearchButton"
                                Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Content="&#xE894;"
                                Width="24" Height="24"
                                Click="OnClearSearchClick" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,12,0,12">
                    <ListBox x:Name="HistoryList"
                             Background="Transparent"
                             BorderThickness="0"
                             FocusVisualStyle="{x:Null}"
                             ItemContainerStyle="{StaticResource HistoryItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectionChanged"
                             MouseDoubleClick="OnRestoreClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Note}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ModifiedLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,5" />
                                    <TextBlock Text="{Binding Preview}" FontSize="11.5"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               MaxHeight="54"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ExpiryLabel}"
                                               FontSize="10"
                                               Foreground="#FFE8A33D"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox x:Name="TrashList"
                             Visibility="Collapsed"
                             Background="Transparent"
                             BorderThickness="0"
                             FocusVisualStyle="{x:Null}"
                             ItemContainerStyle="{StaticResource HistoryItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSelectionChanged"
                             MouseDoubleClick="OnTrashRestoreClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TrashItem}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DeletedLabel}" FontSize="10.5"
                                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,5" />
                                    <TextBlock Text="{Binding Preview}" FontSize="11.5"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               MaxHeight="54"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ExpiryLabel}"
                                               FontSize="10"
                                               Foreground="#FFE8A33D"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyText"
                               Text="{DynamicResource Loc.hist.emptyClosed}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Row="4">
                    <StackPanel x:Name="HistoryActions" Orientation="Horizontal">
                        <Button x:Name="RestoreButton" Style="{StaticResource GhostButton}"
                                Content="{DynamicResource Loc.hist.restore}" Click="OnRestoreClick" />
                        <Button x:Name="DeleteButton" Style="{StaticResource GhostButton}"
                                Content="{DynamicResource Loc.hist.toTrash}" Margin="8,0,0,0" Click="OnDeleteClick" />
                    </StackPanel>

                    <StackPanel x:Name="TrashActions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="TrashRestoreButton" Style="{StaticResource GhostButton}"
                                Content="{DynamicResource Loc.hist.trashRestore}" Click="OnTrashRestoreClick" />
                        <Button x:Name="TrashDeleteButton" Style="{StaticResource GhostButton}"
                                Content="{DynamicResource Loc.hist.deleteForever}" Margin="8,0,0,0" Click="OnTrashDeleteClick" />
                    </StackPanel>

                    <Button x:Name="ClearButton" Style="{StaticResource GhostButton}"
                            Content="{DynamicResource Loc.hist.clearHistory}" HorizontalAlignment="Right" Click="OnClearClick" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="HideyNotes.Windows.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:HideyNotes.Models"
        Title="HideyNotes"
        Width="900" Height="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="-1"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="Transparent">

        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,3,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/AppIcon.png"
                               Width="18" Height="18"
                               Margin="0,0,7,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="HideyNotes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="VersionText"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="6,1,0,0"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="HelpButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE897;"
                                Click="OnHelpClick" />
                        <ToggleButton x:Name="PinButton"
                                      Style="{StaticResource IconToggle}"
                                      Content="&#xE718;"
                                      ToolTip="{DynamicResource Loc.panel.pin}"
                                      Checked="OnPinToggled"
                                      Unchecked="OnPinToggled" />
                        <Button x:Name="SaveButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE74E;"
                                Click="OnSaveClick" />
                        <Button x:Name="HistoryButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE81C;"
                                Click="OnHistoryClick" />
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE713;"
                                Click="OnSettingsClick" />
                        <Button x:Name="HideButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE711;"
                                Click="OnHideClick" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="12,4,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="TabScroll"
                                  Grid.Column="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnTabScrollWheel">
                        <ItemsControl x:Name="TabsItems" ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Note}">
                                    <Border x:Name="TabRoot"
                                            Margin="0,0,4,0"
                                            Padding="10,5,6,5"
                                            CornerRadius="8"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="OnTabMouseDown"
                                            MouseDown="OnTabMouseMiddle"
                                            MouseMove="OnTabMouseMove"
                                            MouseLeftButtonUp="OnTabMouseUp">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <TextBlock x:Name="TabTitle"
                                                           Text="{Binding Title}"
                                                           MaxWidth="150"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                                <TextBox x:Name="TabEdit"
                                                         Width="150"
                                                         FontSize="12"
                                                         Visibility="Collapsed"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         CaretBrush="{DynamicResource TextBrush}"
                                                         KeyDown="OnTabEditKeyDown"
                                                         LostFocus="OnTabEditLostFocus" />
                                            </Grid>
                                            <Button x:Name="TabClose"
                                                    Content="&#xE711;"
                                                    Width="18"
                                                    Height="18"
                                                    Margin="5,0,0,0"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource TabCloseButton}"
                                                    Click="OnTabCloseClick" />
                                            <Border x:Name="TabBadge"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="7"
                                                    Padding="5,1"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MatchCount}" FontSize="9.5" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            <Setter TargetName="TabClose" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                            <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="TabClose" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="TabEdit" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="TabClose" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MatchCount}" Value="0">
                                            <Setter TargetName="TabBadge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTabVisible}" Value="False">
                                            <Setter TargetName="TabRoot" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button x:Name="NewTabButton"
                            Grid.Column="1"
                            Width="26"
                            Height="26"
                            Margin="2,0,0,0"
                            Content="&#xE710;"
                            Style="{StaticResource TabAddButton}"
                            Click="OnNewTabClick" />
                </Grid>

                <Border x:Name="SearchBar"
                        Grid.Row="2"
                        Margin="12,0,12,6"
                        Padding="10,3"
                        Background="{DynamicResource SegmentBrush}"
                        BorderBrush="{DynamicResource SegmentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,8,0" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 TextChanged="OnSearchTextChanged"
                                 KeyDown="OnSearchKeyDown" />

                        <TextBlock x:Name="SearchInfo"
                                   Grid.Column="2"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   MinWidth="34"
                                   TextAlignment="Right" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <RadioButton x:Name="ScopeHere" Style="{StaticResource Segment}" GroupName="scope"
                                         Content="{DynamicResource Loc.panel.search.here}" Tag="here" Margin="0,0,4,0" Checked="OnScopeChecked" />
                            <RadioButton x:Name="ScopeAll" Style="{StaticResource Segment}" GroupName="scope"
                                         Content="{DynamicResource Loc.panel.search.everywhere}" Tag="all" Margin="0,0,4,0" Checked="OnScopeChecked" />
                        </StackPanel>

                        <Button x:Name="PrevMatch" Grid.Column="4" Style="{StaticResource IconButton}"
                                Content="&#xE70E;" Width="26" Height="26" Click="OnPrevMatch" />
                        <Button x:Name="NextMatch" Grid.Column="5" Style="{StaticResource IconButton}"
                                Content="&#xE70D;" Width="26" Height="26" Click="OnNextMatch" />
                        <Button x:Name="CloseSearchButton" Grid.Column="6" Style="{StaticResource IconButton}"
                                Content="&#xE711;" Width="26" Height="26" Click="OnCloseSearchClick" />
                    </Grid>
                </Border>

                <RichTextBox x:Name="Editor"
                             Grid.Row="3"
                             Background="Transparent"
                             BorderThickness="0"
                             FocusVisualStyle="{x:Null}"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             SelectionOpacity="0.4"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsTab="False"
                             SpellCheck.IsEnabled="False"
                             FontFamily="Segoe UI"
                             FontSize="15" />

                <Grid Grid.Row="4" Margin="18,2,16,8">
                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="SettingsLayer"
              Visibility="Collapsed"
              Background="{DynamicResource ScrimBrush}"
              MouseLeftButtonDown="OnScrimClick">

            <Border x:Name="SettingsCard"
                    Width="360"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,52,14,0"
                    Padding="0"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    MouseLeftButtonDown="OnCardClick">

                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.panel.settings.title}" Style="{StaticResource CardTitle}" />

                        <WrapPanel Margin="0,0,0,14">
                            <RadioButton x:Name="TabText" Style="{StaticResource Segment}" GroupName="settingsTab" Content="{DynamicResource Loc.panel.settings.text}" Tag="text" Checked="OnSettingsTabChecked" />
                            <RadioButton x:Name="TabBehavior" Style="{StaticResource Segment}" GroupName="settingsTab" Content="{DynamicResource Loc.panel.settings.behavior}" Tag="behavior" Checked="OnSettingsTabChecked" />
                        </WrapPanel>

                        <StackPanel x:Name="TextPanel">
                        <TextBlock Text="{DynamicResource Loc.panel.font}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="FontBox" Style="{StaticResource FlatCombo}" SelectionChanged="OnFontChanged" />

                        <TextBlock Text="{DynamicResource Loc.panel.fontSize}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource StepButton}" Content="&#xE738;" Margin="0,0,6,0" Click="OnFontSizeMinus" />
                            <TextBlock x:Name="FontSizeValue" Width="52" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            <Button Style="{StaticResource StepButton}" Content="&#xE710;" Margin="6,0,0,0" Click="OnFontSizePlus" />
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Loc.panel.lineSpacing}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource StepButton}" Content="&#xE738;" Margin="0,0,6,0" Click="OnLineHeightMinus" />
                            <TextBlock x:Name="LineHeightValue" Width="52" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            <Button Style="{StaticResource StepButton}" Content="&#xE710;" Margin="6,0,0,0" Click="OnLineHeightPlus" />
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Loc.panel.padding}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource StepButton}" Content="&#xE738;" Margin="0,0,6,0" Click="OnPaddingMinus" />
                            <TextBlock x:Name="PaddingValue" Width="52" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            <Button Style="{StaticResource StepButton}" Content="&#xE710;" Margin="6,0,0,0" Click="OnPaddingPlus" />
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Loc.panel.textColor}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                        <WrapPanel x:Name="SwatchPanel" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource SegmentBrush}"
                                    BorderBrush="{DynamicResource SegmentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Height="30"
                                    Padding="9,0">
                                <Grid>
                                    <TextBox x:Name="HexBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontSize="11.5"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource TextBrush}"
                                             CaretBrush="{DynamicResource TextBrush}"
                                             KeyDown="OnHexKeyDown"
                                             LostFocus="OnHexCommit" />
                                    <TextBlock x:Name="HexPlaceholder"
                                               Text="{DynamicResource Loc.panel.textColor.placeholder}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    Content="{DynamicResource Loc.panel.textColor.palette}"
                                    Margin="6,0,0,0"
                                    Click="OnPickColorClick" />
                        </Grid>

                        <TextBlock x:Name="HexHint"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel x:Name="BehaviorPanel" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Loc.panel.hideDelay}" Style="{StaticResource FieldLabel}" />
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="DelayNow" Style="{StaticResource Segment}" GroupName="delay" Content="{DynamicResource Loc.panel.hideDelay.now}" Tag="0" Checked="OnDelayChecked" />
                                <RadioButton x:Name="Delay300" Style="{StaticResource Segment}" GroupName="delay" Content="{DynamicResource Loc.panel.hideDelay.ms300}" Tag="300" Checked="OnDelayChecked" />
                                <RadioButton x:Name="Delay1000" Style="{StaticResource Segment}" GroupName="delay" Content="{DynamicResource Loc.panel.hideDelay.ms1000}" Tag="1000" Checked="OnDelayChecked" />
                                <RadioButton x:Name="Delay3000" Style="{StaticResource Segment}" GroupName="delay" Content="{DynamicResource Loc.panel.hideDelay.s3}" Tag="3000" Checked="OnDelayChecked" />
                            </WrapPanel>

                            <TextBlock Text="{DynamicResource Loc.panel.transition}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                            <WrapPanel Margin="0,0,0,4">
                                <RadioButton x:Name="TransitionSlide" Style="{StaticResource Segment}" GroupName="transition" Content="{DynamicResource Loc.panel.transition.slide}" Tag="slide" Checked="OnTransitionChecked" />
                                <RadioButton x:Name="TransitionInstant" Style="{StaticResource Segment}" GroupName="transition" Content="{DynamicResource Loc.panel.transition.instant}" Tag="instant" Checked="OnTransitionChecked" />
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource Loc.panel.transition.hint}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="{DynamicResource Loc.panel.theme}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="theme" Content="{DynamicResource Loc.panel.theme.system}" Tag="system" Checked="OnThemeChecked" />
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="theme" Content="{DynamicResource Loc.panel.theme.light}" Tag="light" Checked="OnThemeChecked" />
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="theme" Content="{DynamicResource Loc.panel.theme.dark}" Tag="dark" Checked="OnThemeChecked" />
                            </WrapPanel>

                            <TextBlock Text="{DynamicResource Loc.panel.language}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                            <ComboBox x:Name="LanguageBox"
                                      Style="{StaticResource FlatCombo}"
                                      SelectionChanged="OnLanguageChanged"
                                      Margin="0,0,0,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource Loc.panel.language.hint}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="{DynamicResource Loc.panel.monitor}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                            <ComboBox x:Name="MonitorBox"
                                      Style="{StaticResource FlatCombo}"
                                      SelectionChanged="OnMonitorChanged"
                                      Margin="0,0,0,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="MonitorHint"
                                       Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <TextBlock x:Name="HotkeyLabel" Text="" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="HotkeyOn" Style="{StaticResource Segment}" GroupName="hotkey" Content="{DynamicResource Loc.common.on}" Tag="true" Checked="OnHotkeyChecked" />
                                <RadioButton x:Name="HotkeyOff" Style="{StaticResource Segment}" GroupName="hotkey" Content="{DynamicResource Loc.common.off}" Tag="false" Checked="OnHotkeyChecked" />
                            </WrapPanel>

                            <TextBlock Text="{DynamicResource Loc.panel.rememberSearch}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="RememberSearchOn" Style="{StaticResource Segment}" GroupName="remember" Content="{DynamicResource Loc.panel.rememberSearch.on}" Tag="true" Checked="OnRememberSearchChecked" />
                                <RadioButton x:Name="RememberSearchOff" Style="{StaticResource Segment}" GroupName="remember" Content="{DynamicResource Loc.panel.rememberSearch.off}" Tag="false" Checked="OnRememberSearchChecked" />
                            </WrapPanel>

                            <TextBlock Text="{DynamicResource Loc.panel.autostart}" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
                            <WrapPanel Margin="0,0,0,6">
                                <RadioButton x:Name="AutoStartOn" Style="{StaticResource Segment}" GroupName="autostart" Content="{DynamicResource Loc.common.yes}" Tag="true" Checked="OnAutoStartChecked" />
                                <RadioButton x:Name="AutoStartOff" Style="{StaticResource Segment}" GroupName="autostart" Content="{DynamicResource Loc.common.no}" Tag="false" Checked="OnAutoStartChecked" />
                            </WrapPanel>

                            <TextBlock x:Name="TrayHint"
                                       Text=""
                                       Style="{StaticResource FieldLabel}"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,8" />
                            <Button x:Name="ExitButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="{DynamicResource Loc.panel.quit}"
                                    HorizontalAlignment="Left"
                                    Click="OnExitClick" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
